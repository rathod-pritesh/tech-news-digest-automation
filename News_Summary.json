    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\n\nconst topics = [\n  { key: 'golang',               label: '🐹 Golang' },\n  { key: 'sveltekit',            label: '🔥 SvelteKit' },\n  { key: 'artificial+intelligence', label: '🤖 AI' },\n  { key: 'machine+learning',     label: '🧠 ML' },\n  { key: 'tech+trends',          label: '📈 Tech Trends' },\n  { key: 'new+technology',       label: '💡 Inventions' },\n];\n\nconst selected = [];\n\nfor (const item of allItems) {\n  const articles = item.json?.articles || [];\n\n  const clean = articles.filter(a => \n    a.title &&\n    a.title !== '[Removed]' &&\n    a.url &&\n    a.url !== 'https://removed.com'\n  );\n\n  if (clean.length > 0) {\n    selected.push(clean[0]);\n  }\n}\n\nconst final = selected.slice(0, 7);\n\n// build html body\nconst today = new Date().toDateString();\n\nlet html = `\n<html><body style=\"font-family:sans-serif;max-width:660px;margin:auto;padding:24px;background:#f5f5f5\">\n<h2 style=\"color:#1a1a2e;margin-bottom:4px\">🗞️ Daily Tech Digest</h2>\n<p style=\"color:#888;font-size:13px;margin-top:0\">${today} · ${final.length} stories</p>\n<hr style=\"border:none;border-top:2px solid #e0e0e0;margin-bottom:20px\"/>\n`;\n\nfor (const a of final) {\n  html += `\n  <div style=\"background:#fff;border-radius:10px;padding:16px;margin-bottom:14px;border-left:4px solid #4f46e5\">\n  <a href=\"${a.url}\" style=\"font-size:15px;font-weight:600;color:#1a1a2e;text-decoration:none;line-height:1.4\">\n    ${a.title}\n  </a>\n  <p style=\"color:#555;font-size:13px;margin:8px 0 6px\">${a.description}</p>\n  <small style=\"color:#aaa\">${a.source?.name || 'Unknown'} · ${new Date(a.publishedAt).toLocaleDateString()}</small>\n</div>`;\n}\n\n\nhtml += `</body></html>`;\n\nreturn [{ json: { html, articleCount: final.length, date: today } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
